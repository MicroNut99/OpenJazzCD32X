+		{ "SONG2",    "TECHNOIR" },
+		{ "SONG3",    "TUBELECTRIC" },
+		{ "SONG4",    "TURTEMPLE" },
+		{ "SONG5",    "NIPPIUS" },
+		{ "SONG6",    "JUNGROCK" },
+		{ "SONG7",    "LETNI" },
+		{ "SONG8",    "FANOLINT" },
+		{ "SONG9",    "MARBELARA" },
+		{ "SONGCD0",  "EXOTICUS" },
+		{ "SONGCD1",  "INDUSTRIUS" },
+		{ "SONGCD2",  "MUCKAMOK" },
+		{ "SONGCD3",  "RANEFORUS" },
+		{ "SONGCD4",  "STONAR" },
+		{ "SONGCD5",  "DECKSTAR" },
+		{ "SONGCD6",  "CERAMICUS" },
+		{ "SONGCD7",  "DESERTO" },
+		{ "SONGCD8",  "LAGUNICUS" },
+		{ "XM2",      "HOLIDAIUS" },
+		{ "XM3",      "HOLIDAIUS 2" },
+		{ "XMAS2",    "CANDION" },
+		{ "XMAS3",    "BLOXONIUS" }
+	};
+	const int nSongs = sizeof(songs) / sizeof(songs[0]);
+	const int firstSong = 19;   // SONG5 (Micronut99)
+
+	// Two pages, each shown for 8 seconds
+	const char* const page1[] = {
+		"JAZZ JACKRABBIT",
+		"EPIC MEGAGAMES 1994",
+		"",
+		"A GAME BY",
+		"ARJAN BRUSSEE",
+		"CLIFF BLESZINSKI",
+		"",
+		"OPENJAZZ",
+		"ALISTER THOMSON",
+		"AND CONTRIBUTORS"
+	};
+	const char* const page2[] = {
+		"D32XR 32X CODE",
+		"VICTOR LUCHITS",
+		"",
+		"SEGA CD AND 32X FRAMEWORK",
+		"CHILLY WILLY",
+		"",
+		"SEGA CD32X PORT",
+		"MICRONUT99",
+		"",
+		"THANK YOU FOR PLAYING!"
+	};
