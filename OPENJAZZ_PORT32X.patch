+	// names: which planet's levels play each song, read from the game's own level files.
+	const Song songs[] = {
+		{ "BONUS",    "BONUS STAGE" },
+		{ "BOSS",     "BOSS - GUARDIAN" },
+		{ "ENDLEVEL", "END OF LEVEL" },
+		{ "ENDSONG",  "ENDING" },
+		{ "MENUSNG",  "MAIN MENU" },
+		{ "SECRET",   "SECRET" },
+		{ "SONG0",    "DIAMONDUS" },
+		{ "SONG1",    "SLUGGION" },
+		{ "SONG10",   "CRYSILIS" },
+		{ "SONG11",   "ORBITUS" },
